{
  "extends": ["plugin:@nx/react", "../../../.eslintrc.json"],
  "ignorePatterns": ["**/vite.config.*.timestamp*"],
  "overrides": [
    {
      "files": ["sw.ts"],
      "rules": {
        "no-restricted-globals": "off"
      },
      "globals": {
        "self": "readonly",
        "Clients": "readonly",
        "ServiceWorkerGlobalScope": "readonly",
        "ExtendableEvent": "readonly",
        "PushEvent": "readonly",
        "NotificationEvent": "readonly",
        "NotificationOptions": "readonly",
        "console": "readonly"
      }
    },
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {}
    },
    {
      "files": ["*.ts", "*.tsx"],
      "rules": {}
    },
    {
      "files": ["*.js", "*.jsx"],
      "rules": {}
    }
  ]
}

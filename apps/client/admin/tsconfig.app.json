{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["dom"],
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "vite/client"
    ],
    "rootDir": "src",
    "baseUrl": ".",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@org/pages-admin-not-found": [
        "../../../libs/client/pages/admin/pages-not-found/src/index.ts"
      ],
      "@org/pages-admin-overview": ["../../../libs/client/pages/admin/pages-overview/src/index.ts"],
      "@org/pages-admin-user-detail": [
        "../../../libs/client/pages/admin/pages-user-detail/src/index.ts"
      ],
      "@org/pages-admin-users": ["../../../libs/client/pages/admin/pages-users/src/index.ts"]
    }
  },
  "exclude": [
    "out-tsc",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.test.js",
    "src/**/*.spec.jsx",
    "src/**/*.test.jsx",
    "jest.config.ts",
    "jest.config.cts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../../../libs/common/tsconfig.lib.json"
    },
    {
      "path": "../../../libs/client/shared/tsconfig.lib.json"
    },
    {
      "path": "../../../libs/client/entities/user/tsconfig.lib.json"
    },
    {
      "path": "../../../libs/client/pages/admin/pages-users/tsconfig.lib.json"
    },
    {
      "path": "../../../libs/client/pages/admin/pages-user-detail/tsconfig.lib.json"
    },
    {
      "path": "../../../libs/client/pages/admin/pages-overview/tsconfig.lib.json"
    },
    {
      "path": "../../../libs/client/pages/admin/pages-not-found/tsconfig.lib.json"
    }
  ]
}

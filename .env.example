# Polygon — пример окружения для локальной разработки
# Скопируй: cp example.env .env
# NODE_ENV=test читает .env.test, NODE_ENV=production — .env.production (те же ключи).
# Валидация: libs/backend/core/src/config/env.schema.ts — падает на старте со списком полей.

NODE_ENV=development

# ===========================================
# DATABASE (docker-compose.yml + infra/db/init)
# ===========================================
POSTGRES_USER=polygon
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=polygon
AUTH_DATABASE_URL=postgresql://polygon:change-me-postgres-password@localhost:5432/polygon_auth
USER_DATABASE_URL=postgresql://polygon:change-me-postgres-password@localhost:5432/polygon_user
CHAT_DATABASE_URL=postgresql://polygon:change-me-postgres-password@localhost:5432/polygon_chat
NOTIFICATION_DATABASE_URL=postgresql://polygon:change-me-postgres-password@localhost:5432/polygon_notification
MEDIA_DATABASE_URL=postgresql://polygon:change-me-postgres-password@localhost:5432/polygon_media
PRISMA_POOL_MAX=10
PRISMA_POOL_MAX_CHAT=20

# ===========================================
# JWT (минимум 32 символа)
# Сгенерировать: openssl rand -hex 32
# ===========================================
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-000000000000
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-00000000000
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800

# ===========================================
# THROTTLE / WS LIMITS (single-node phase 1)
# ===========================================
THROTTLE_ANON_LIMIT=100
THROTTLE_USER_LIMIT=300
WS_SEND_LIMIT_PER_MIN=30
MEMBERSHIP_CACHE_TTL_SEC=45

# ===========================================
# MINIO (S3-совместимое объектное хранилище)
# ===========================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_USE_SSL=false
MINIO_PUBLIC_BUCKET=polygon-avatars
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ===========================================
# RABBITMQ
# ===========================================
RABBITMQ_URL=amqp://polygon:change-me-postgres-password@localhost:5672
RABBITMQ_PREFETCH=200
RABBITMQ_USER=polygon
RABBITMQ_PASSWORD=change-me-postgres-password

# ===========================================
# REDIS
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# PORTS (должны совпадать с apps/backend/*/src/main.ts)
# ===========================================
GATEWAY_PORT=3000
GATEWAY_WORKERS=0
GATEWAY_METRICS_PORT=3110
AUTH_PORT=3002
USER_PORT=3001
CHAT_PORT=3003
NOTIFICATION_PORT=3005
MEDIA_PORT=3004
SEARCH_PORT=3006

# ===========================================
# OBSERVABILITY (docker-compose.yml: prometheus/grafana/loki/tempo)
# ===========================================
DEPLOYMENT_ENVIRONMENT=development
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_VERSION=0.0.1
LOG_LEVEL=info
LOG_FORMAT=pretty
AUTH_METRICS_PORT=3012
CHAT_METRICS_PORT=3013
MEDIA_METRICS_PORT=3014
NOTIFICATION_METRICS_PORT=3015
PROMETHEUS_RETENTION_TIME=15d
LOKI_RETENTION_PERIOD=168h
TEMPO_RETENTION_PERIOD=72h
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# ===========================================
# VAPID (Web Push)
# Сгенерировать: npx web-push generate-vapid-keys
# ===========================================
VAPID_PUBLIC_KEY=change-me-vapid-public-key
VAPID_PRIVATE_KEY=change-me-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# ===========================================
# SMTP / EMAIL (пустые = письма не уйдут, код не упадёт)
# ===========================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Polygon <no-reply@example.com>

# ===========================================
# APP
# ===========================================
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:4200

# Frontend API base URL (пусто = same origin через Vite proxy)
VITE_API_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000

# ===========================================
# MEILISEARCH
# ===========================================
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=change-me-meilisearch-key

# ===========================================
# OAUTH / СОЦИАЛЬНЫЙ ВХОД (пустые = кнопки скрыты, обычный логин работает)
# GitHub — https://github.com/settings/developers
# Google — https://console.cloud.google.com/apis/credentials
# ===========================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

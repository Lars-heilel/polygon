# ===========================================
# ПОЛЬЗОВАТЕЛЬСКИЕ НАСТРОЙКИ / USER SETTINGS
# ===========================================

# Порт для API сервиса пользователей
# API port for user service
USER_PORT=3001

# Порт для API сервиса аутентификации
# API port for auth service
AUTH_PORT=3002

# Порт для API сервиса чатов
# API port for chat service
CHAT_PORT=3003

# Порт для API сервиса медиа
# API port for media service
MEDIA_PORT=3004

# Порт для API сервиса уведомлений
# API port for notification service
NOTIFICATION_PORT=3005

# Порт для сервиса поиска
# API port for search service
SEARCH_PORT=3006


# ===========================================
# ПОИСК / SEARCH
# ===========================================

# URL Meilisearch (по умолчанию локальный Docker)
# Meilisearch URL (defaults to local Docker instance)
MEILISEARCH_URL=http://localhost:7700

# Мастер-ключ Meilisearch (обязателен в production)
# Meilisearch master key (required in production)
MEILISEARCH_MASTER_KEY=polygon_meilisearch_key


# ===========================================
# БАЗА ДАННЫХ / DATABASE
# ===========================================

# Хост PostgreSQL
# PostgreSQL host
DATABASE_HOST=localhost

# Порт PostgreSQL
# PostgreSQL port
DATABASE_PORT=5432

# Пользователь PostgreSQL
# PostgreSQL user
DATABASE_USER=polygon

# Пароль PostgreSQL (измените для production!)
# PostgreSQL password (change for production!)
DATABASE_PASSWORD=your_secure_password_here

# Префикс имён баз данных для микросервисов
# Database name prefix for microservices
DATABASE_NAME_PREFIX=polygon_

# Connection strings для каждого сервиса (используются в PrismaService)
# Connection strings per service (used in PrismaService)
AUTH_DATABASE_URL=postgresql://polygon:your_secure_password_here@localhost:5432/polygon_auth
USER_DATABASE_URL=postgresql://polygon:your_secure_password_here@localhost:5432/polygon_user


# ===========================================
# REDIS
# ===========================================

# Хост Redis
# Redis host
REDIS_HOST=localhost

# Порт Redis
# Redis port
REDIS_PORT=6379

# Пароль Redis (опционально)
# Redis password (optional)
REDIS_PASSWORD=


# ===========================================
# RABBITMQ
# ===========================================

# URL подключения к RabbitMQ (amqp://user:password@host:port)
# RabbitMQ connection URL
RABBITMQ_URL=amqp://polygon:your_secure_password_here@localhost:5672

# Переменные для Docker Compose (инициализация контейнера)
# Used by docker-compose.yml to initialize the container
RABBITMQ_USER=polygon
RABBITMQ_PASSWORD=your_secure_password_here

# Порт Management UI
# Management UI port
RABBITMQ_MANAGEMENT_PORT=15672


# ===========================================
# JWT / JWT
# ===========================================

# Секрет для access токенов (min 32 символа)
# Secret for access tokens (min 32 chars)
JWT_ACCESS_SECRET=your_access_secret_min_32_chars_change_in_production

# Секрет для refresh токенов (min 32 символа, отличается от access!)
# Secret for refresh tokens (min 32 chars, must differ from access!)
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_change_in_production

# Время жизни access токена (в секундах, default 900 = 15 мин)
# Access token lifetime (in seconds, default 900 = 15 min)
JWT_ACCESS_TOKEN_EXPIRES=900

# Время жизни refresh токена (в секундах, default 604800 = 7 дней)
# Refresh token lifetime (in seconds, default 604800 = 7 days)
JWT_REFRESH_TOKEN_EXPIRES=604800


# ===========================================
# SMTP / EMAIL
# ===========================================

# SMTP хост (например smtp.gmail.com)
SMTP_HOST=localhost

# SMTP порт (587 для TLS, 465 для SSL, 1025 для mailhog)
SMTP_PORT=587

# SMTP учётные данные (опционально для локальной разработки)
SMTP_USER=
SMTP_PASSWORD=

# Отправитель писем
SMTP_FROM=Polygon <noreply@polygon.app>

# Публичный URL Gateway (используется в OAuth callback и ссылках в письмах)
APP_URL=http://localhost:3000

# URL клиентского приложения (куда редиректим после OAuth)
CLIENT_URL=http://localhost:4200


# ===========================================
# OAUTH / СОЦИАЛЬНЫЙ ВХОД
# ===========================================

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Yandex OAuth — https://oauth.yandex.ru/client/new
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ===========================================
# DOCKER COMPOSE
# ===========================================

# PostgreSQL credentials for Docker (used in docker-compose.yml)
POSTGRES_USER=polygon
POSTGRES_PASSWORD=polygon_password
POSTGRES_DB=polygon

# Grafana admin credentials for Docker
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=polygon_grafana


# ===========================================
# ОБЩИЕ НАСТРОЙКИ / COMMON SETTINGS
# ===========================================

# Режим работы (development | production)
# Application mode (development | production)
NODE_ENV=development

# Уровень логирования (debug | info | warn | error)
# Log level (debug | info | warn | error)
LOG_LEVEL=debug

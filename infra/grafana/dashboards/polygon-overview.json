    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "login_failure" }, "properties": [{ "id": "color", "value": { "fixedColor": "#e05252", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "register" }, "properties": [{ "id": "color", "value": { "fixedColor": "#73bf69", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "login_success" }, "properties": [{ "id": "color", "value": { "fixedColor": "#5794f2", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum by (event) (rate(auth_events_total[$__rate_interval]))",
          "legendFormat": "{{event}}",
          "refId": "A"
        }
      ],
      "title": "Auth events / sec",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["sum"] }, "orientation": "horizontal", "textMode": "auto", "colorMode": "background" },
      "targets": [
        { "expr": "sum by (event) (increase(auth_events_total[$__range]))", "legendFormat": "{{event}}", "refId": "A" }
      ],
      "title": "Auth totals (selected range)",
      "type": "bargauge"
    },


{
  "name": "@org/common",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {},
  "nx": {
    "tags": ["scope:shared", "type:framework-agnostic"],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "cache": true,
        "options": {
          "command": "tsc -p tsconfig.build.json",
          "cwd": "libs/common"
        },
        "outputs": ["{projectRoot}/dist"]
      }
    }
  }
}

{
  "name": "@org/common",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {},
  "nx": {
    "tags": ["scope:shared", "type:framework-agnostic"],
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": ["{options.outputPath}"],
        "options": {
          "outputPath": "libs/common/dist",
          "main": "libs/common/src/index.ts",
          "tsConfig": "libs/common/tsconfig.lib.json",
          "assets": []
        }
      }
    }
  }
}

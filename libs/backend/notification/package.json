{
  "name": "@org/notification",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {},
  "nx": {
    "tags": [
      "scope:backend",
      "type:business"
    ],
    "targets": {
      "prisma-generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma generate --config prisma.config.ts",
          "cwd": "libs/backend/notification"
        }
      }
    }
  }
}

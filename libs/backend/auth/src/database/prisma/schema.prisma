
generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CREATOR
  ADMIN
  MODERATOR
  USER
}

model Credentials {
  id             String         @id @default(uuid(7)) @db.Uuid @map("id")
  email          String         @unique @db.VarChar(254) @map("email")
  role           Role           @default(USER) @map("role")
  passwordHash   String?        @db.VarChar(255) @map("password_hash")
  isVerified     Boolean        @default(false) @map("is_verified")
  lockedAt       DateTime?      @db.Timestamptz(3) @map("locked_at")
  lockedUntil    DateTime?      @db.Timestamptz(3) @map("locked_until")
  isBanned       Boolean        @default(false) @map("is_banned")
  bannedUntil    DateTime?      @db.Timestamptz(3) @map("banned_until")
  banReason      String?        @db.VarChar(255) @map("ban_reason")
  bannedAt       DateTime?      @db.Timestamptz(3) @map("banned_at")
  bannedBy       String?        @db.Uuid @map("banned_by")
  createdAt      DateTime       @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3) @map("updated_at")
  refreshTokens  Session[]
  oauthAccounts  OAuthAccount[]

  @@map("credentials")
}

model OAuthAccount {
  id            String      @id @default(uuid(7)) @db.Uuid @map("id")
  provider      String      @db.VarChar(32) @map("provider")
  providerId    String      @db.VarChar(128) @map("provider_id")
  credentials   Credentials @relation(fields: [credentialsId], references: [id], onDelete: Cascade)
  credentialsId String      @db.Uuid @map("credentials_id")
  createdAt     DateTime    @default(now()) @db.Timestamptz(3) @map("created_at")

  @@unique([provider, providerId])
  @@index([credentialsId])
  @@map("oauth_accounts")
}

model Session {
  id            String    @id @default(uuid(7)) @db.Uuid @map("id")
  tokenHash     String    @unique @db.Char(64) @map("token_hash")
  credentialsId String    @db.Uuid @map("credentials_id")
  expiresAt     DateTime  @db.Timestamptz(3) @map("expires_at")
  revokedAt     DateTime? @db.Timestamptz(3) @map("revoked_at")
  lastActiveAt  DateTime? @db.Timestamptz(3) @map("last_active_at")
  ip            String?   @db.VarChar(45) @map("ip")
  country       String?   @db.VarChar(2) @map("country")
  os            String?   @db.VarChar(64) @map("os")
  browser       String?   @db.VarChar(64) @map("browser")
  device        String?   @db.VarChar(64) @map("device")
  userAgent     String?   @db.VarChar(512) @map("user_agent")
  createdAt     DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")

  credentials   Credentials @relation(fields: [credentialsId], references: [id], onDelete: Cascade)

  @@index([credentialsId])
  @@index([expiresAt])
  @@map("sessions")
}

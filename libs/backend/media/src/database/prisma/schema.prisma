generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FileStatus {
  PENDING
  READY
  DELETING
}

enum FileCategory {
  AVATAR
  IMAGE
  AUDIO
  VIDEO
  FILE
  VOICE
  CIRCLE
}

enum MediaReferenceOwnerType {
  MESSAGE_ATTACHMENT
}

model File {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid @map("id")
  bucket       String       @map("bucket")
  key          String       @unique @map("key")
  originalName String       @map("original_name")
  mimeType     String       @map("mime_type")
  size         Int          @map("size")
  url          String?      @map("url")
  uploaderId   String?      @db.Uuid @map("uploader_id")
  status       FileStatus   @default(PENDING) @map("status")
  chatId       String?      @db.Uuid @map("chat_id")
  category     FileCategory @map("category")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  references   MediaReference[]
}

model MediaReference {
  id        String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  fileId    String                  @db.Uuid @map("file_id")
  ownerType MediaReferenceOwnerType @map("owner_type")
  ownerId   String                  @db.Uuid @map("owner_id")
  createdAt DateTime                @default(now()) @map("created_at")

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([ownerType, ownerId])
  @@index([fileId])
  @@map("media_references")
}


generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChatRole {
  ADMIN
  MODERATOR
  MEMBER
}

model Chat {
  id            String    @id @default(uuid(7)) @db.Uuid @map("id")
  type          String    @map("type")
  name          String?   @db.VarChar(128) @map("name")
  avatarUrl     String?   @db.VarChar(2048) @map("avatar_url")
  selfOwnerId   String?   @unique @db.Uuid @map("self_owner_id")
  directKey     String?   @db.VarChar(128) @map("direct_key")
  lastMessageId BigInt?   @map("last_message_id")
  lastMessageAt DateTime? @db.Timestamptz(3) @map("last_message_at")
  createdAt     DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3) @map("updated_at")

  members  ChatMember[]
  messages Message[]

  @@index([type])
  @@index([lastMessageAt, id])
  @@unique([directKey])
  @@map("chats")
}

model ChatMember {
  chatId            String    @db.Uuid @map("chat_id")
  userId            String    @db.Uuid @map("user_id")
  role              ChatRole  @default(MEMBER) @map("role")
  joinedAt          DateTime  @default(now()) @db.Timestamptz(3) @map("joined_at")
  lastReadMessageId BigInt?   @map("last_read_message_id")
  lastReadAt        DateTime? @db.Timestamptz(3) @map("last_read_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
  @@index([userId, chatId])
  @@index([chatId, lastReadAt])
  @@map("chat_members")
}

model Message {
  id              BigInt    @id @default(autoincrement()) @map("id")
  clientId        String?   @db.VarChar(128) @map("client_id")
  chatId          String    @db.Uuid @map("chat_id")
  senderId        String    @db.Uuid @map("sender_id")
  type            String    @default("TEXT") @map("type")
  text            String?   @db.Text @map("text")
  hasLink         Boolean   @default(false) @map("has_link")
  editedAt        DateTime? @db.Timestamptz(3) @map("edited_at")
  deletedAt       DateTime? @db.Timestamptz(3) @map("deleted_at")
  deletedById     String?   @db.Uuid @map("deleted_by_id")
  createdAt       DateTime  @default(now()) @db.Timestamptz(3) @map("created_at")
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3) @map("updated_at")

  chat      Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  deletions MessageDeletion[]
  attachments    MessageAttachment[]
  forwardContext MessageForwardContext?

  @@index([chatId, createdAt, id])
  @@index([chatId, updatedAt, id])
  @@index([deletedAt])
  @@index([senderId])
  @@map("messages")
}

model MessageAttachment {
  id               String   @id @default(uuid(7)) @db.Uuid @map("id")
  messageId        BigInt   @map("message_id")
  mediaId          String   @db.Uuid @map("media_id")
  fileNameSnapshot String?  @db.VarChar(255) @map("file_name_snapshot")
  fileSizeSnapshot BigInt?  @map("file_size_snapshot")
  mimeSnapshot     String?  @db.VarChar(127) @map("mime_snapshot")
  category         String   @map("category")
  createdAt        DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([mediaId])
  @@map("message_attachments")
}

model MessageForwardContext {
  messageId                         BigInt   @id @map("message_id")
  originalMessageId                 BigInt?  @map("original_message_id")
  originalChatId                    String?  @db.Uuid @map("original_chat_id")
  originalAuthorId                  String   @db.Uuid @map("original_author_id")
  originalAuthorNameSnapshot        String   @db.VarChar(32) @map("original_author_name_snapshot")
  originalAuthorDisplayNameSnapshot String?  @db.VarChar(64) @map("original_author_display_name_snapshot")
  originalMessageCreatedAt          DateTime @db.Timestamptz(3) @map("original_message_created_at")
  originalMessageType               String   @map("original_message_type")
  originalTextPreview               String?  @db.VarChar(280) @map("original_text_preview")
  originalFileNamePreview           String?  @db.VarChar(255) @map("original_file_name_preview")
  snapshotVersion                   Int      @default(1) @map("snapshot_version")
  createdAt                         DateTime @default(now()) @db.Timestamptz(3) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([originalAuthorId])
  @@index([originalChatId])
  @@map("message_forward_contexts")
}

model MessageDeletion {
  messageId BigInt   @map("message_id")
  userId    String   @db.Uuid @map("user_id")
  deletedAt DateTime @default(now()) @db.Timestamptz(3) @map("deleted_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
  @@map("message_deletions")
}

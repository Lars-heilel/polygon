
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChatType {
  DIRECT
  GROUP
  CHANNEL
}

enum ChatRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  VOICE
  FILE
  SYSTEM
}

model Chat {
  id          String   @id @default(uuid())
  type        ChatType @map("type")
  name        String?  @map("name")
  avatarUrl   String?  @map("avatar_url")
  selfOwnerId String?  @unique @map("self_owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members  ChatMember[]
  messages Message[]

  @@index([type])
}

model ChatMember {
  chatId            String    @map("chat_id")
  userId            String    @map("user_id")
  role              ChatRole  @default(MEMBER) @map("role")
  joinedAt          DateTime  @default(now()) @map("joined_at")
  lastReadMessageId String?   @map("last_read_message_id")
  lastReadAt        DateTime? @map("last_read_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId])
  @@index([chatId, lastReadAt])
}

model Message {
  id              String      @id @default(uuid())
  clientId        String?     @map("client_id")
  chatId          String      @map("chat_id")
  senderId        String      @map("sender_id")
  type            MessageType @default(TEXT) @map("type")
  text            String?     @map("text")
  fileId          String?     @map("file_id")
  fileBucket      String?     @map("file_bucket")
  fileKey         String?     @map("file_key")
  fileName        String?     @map("file_name")
  fileSize        Int?        @map("file_size")
  fileMime        String?     @map("file_mime")
  fileCategory    String?     @map("file_category")
  forwardedFromId String?     @map("forwarded_from_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([chatId, clientId])
}

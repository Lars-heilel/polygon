{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "vite/client"
    ],
    "rootDir": "src",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
  },
  "exclude": [
    "out-tsc",
    "dist",
    "**/*.spec.ts",
    "src/**/*.spec.ts",
    "**/*.spec.tsx",
    "src/**/*.spec.tsx",
    "**/*.test.ts",
    "src/**/*.test.ts",
    "**/*.test.tsx",
    "src/**/*.test.tsx",
    "src/test-stubs/**/*"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../../entities/admin/tsconfig.lib.json"
    },
    {
      "path": "../../shared/tsconfig.lib.json"
    },
    {
      "path": "../../../common/tsconfig.lib.json"
    }
  ]
}
